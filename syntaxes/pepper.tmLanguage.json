{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Pepper",
  "scopeName": "source.pep",
  "patterns": [
    { "include": "#comment" },
    { "include": "#import" },
    { "include": "#interpolated-string" },
    { "include": "#string" },
    { "include": "#character" },
    { "include": "#number" },
    { "include": "#keyword" },
    { "include": "#builtin-type" },
    { "include": "#operator" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.line.documentation.pep",
          "begin": "##(?!#)",
          "end": "$",
          "patterns": [
            {
              "match": "(@(?:param|typeParam))\\s+([A-Za-z_][A-Za-z0-9_]*)",
              "captures": {
                "1": { "name": "storage.type.class.doc.pep" },
                "2": { "name": "variable.parameter.doc.pep" }
              }
            },
            { "match": "@[A-Za-z]+", "name": "storage.type.class.doc.pep" }
          ]
        },
        { "name": "comment.line.number-sign.pep", "match": "#.*$" }
      ]
    },
    "import": {
      "name": "meta.import.pep",
      "begin": "\\b(import)\\b",
      "beginCaptures": { "1": { "name": "keyword.control.import.pep" } },
      "end": ";|$",
      "patterns": [
        { "include": "#string" },
        { "match": "\\b(from|as)\\b", "name": "keyword.control.import.pep" },
        { "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b", "name": "entity.name.namespace.pep" }
      ]
    },
    "interpolated-string": {
      "name": "string.interpolated.pep",
      "begin": "\\$\"",
      "end": "\"",
      "patterns": [
        { "match": "\\\\.", "name": "constant.character.escape.pep" },
        { "match": "\\{\\{|\\}\\}", "name": "constant.character.escape.pep" },
        {
          "name": "meta.interpolation.pep",
          "contentName": "meta.embedded.line.pep",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.pep" } },
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.pep" } },
          "patterns": [{ "include": "#interpolation-braces" }, { "include": "$self" }]
        }
      ]
    },
    "interpolation-braces": {
      "comment": "Braces nested in an interpolated expression, so an inner '}' does not end it.",
      "begin": "\\{",
      "end": "\\}",
      "patterns": [{ "include": "#interpolation-braces" }, { "include": "$self" }]
    },
    "string": {
      "name": "string.quoted.double.pep",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "match": "\\\\.", "name": "constant.character.escape.pep" }
      ]
    },
    "character": {
      "name": "string.quoted.single.pep",
      "match": "'(?:[^'\\\\]|(\\\\(?:x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\}|.)))'",
      "captures": {
        "1": { "name": "constant.character.escape.pep" }
      }
    },
    "number": {
      "patterns": [
        { "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b", "name": "constant.numeric.float.pep" },
        { "match": "\\b[0-9]+\\b", "name": "constant.numeric.integer.pep" }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "match": "\\b(import|as|struct|var|const|if|else|while|for|in|break|continue|return|extern|and|or|new|construct|destruct|static|sizeof|trait|extend|with|export|private|enum|match)\\b",
          "name": "keyword.control.pep"
        },
        {
          "match": "(?<!\\.)\\bis\\b(?=\\s+[A-Za-z0-9_'\"@-])",
          "name": "keyword.control.pep"
        },
        {
          "match": "\\bshared\\b(?=\\s*\\()",
          "name": "storage.modifier.shared.pep"
        },
        {
          "match": "\\b(true|false|null)\\b",
          "name": "constant.language.pep"
        }
      ]
    },
    "builtin-type": {
      "patterns": [
        {
          "match": "\\b(int|uint|short|ushort|float|double|bool|void|char|long|ulong|byte|[iu](?:8|16|32|64)|f(?:32|64)|String|Array|HashMap|HashSet|Atomic|Result|Error)\\b",
          "name": "storage.type.builtin.pep"
        }
      ]
    },
    "operator": {
      "patterns": [
        {
          "match": "(\\.\\.>|\\.\\.(?!\\.)|=>|<<=|>>=|==|!=|<=|>=|\\+=|-=|\\*=|/=|%=|\\+\\+|--|<<|>>|\\*\\*|&&|\\|\\||&=|\\|=|\\^=|\\+|-|\\*|/|%|<|>|&|\\||\\^|!|~)",
          "name": "keyword.operator.pep"
        }
      ]
    }
  }
}
